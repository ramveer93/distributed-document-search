{
  "uid": "deeprunner",
  "title": "Deeprunner",
  "tags": [
    "deeprunner"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "p95 latency by route  (SLO 500ms)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "request rate by status",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "outbox depth  \u2014  growth means the relay is stuck",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "outbox_unpublished_depth",
          "legendFormat": "unpublished",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "kafka consumer lag  \u2014  the index is drifting",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kafka_consumer_lag",
          "legendFormat": "lag",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "documents by status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "documents_by_status",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "cache hit ratio  \u2014  the budget assumes 60-70%",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(cache_lookups_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_lookups_total[5m])), 0.001)",
          "legendFormat": "hit ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PROM"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Trace one request across every service  \u2014  paste a Request ID above",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "LOKI"
      },
      "options": {
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "LOKI"
          },
          "expr": "{job=\"deeprunner\"} |= \"$request_id\" | json | line_format \"{{.service}}  {{.msg}}\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Errors and warnings, all services",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "LOKI"
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "LOKI"
          },
          "expr": "{job=\"deeprunner\"} | json | level=~\"WARNING|ERROR\" | line_format \"{{.service}}  {{.msg}}  {{.request_id}}\"",
          "queryType": "range"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "request_id",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  }
}