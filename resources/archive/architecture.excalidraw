    {
      "id": "el103",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 974295421,
      "version": 1,
      "versionNonce": 2018978167,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 80,
      "y": 2567.5,
      "width": 546.0,
      "height": 195.0,
      "text": "rl:{tenant}:{yyyymmddhhmm}   INCR + EXPIRE 60    per-tenant quota\nidem:{tenant}:{key}          SETNX  TTL 24h      idempotent POST\nq:{tenant}:{v}:{sha1(q|filters|page|size)}\n                             JSON   TTL 60s      query result cache\nd:{tenant}:{doc_id}          JSON   TTL 300s     single document\ninv:{tenant}                 INCR                bumps {v} above and\n                                                 voids every cached\n                                                 query for that tenant\n\nL1  in-process LRU, 10k entries, 5s TTL   absorbs hot-key bursts\n    single-flight per key so a miss cannot stampede OpenSearch\nEvery key is tenant-prefixed: a cache bug cannot leak across tenants.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "rl:{tenant}:{yyyymmddhhmm}   INCR + EXPIRE 60    per-tenant quota\nidem:{tenant}:{key}          SETNX  TTL 24h      idempotent POST\nq:{tenant}:{v}:{sha1(q|filters|page|size)}\n                             JSON   TTL 60s      query result cache\nd:{tenant}:{doc_id}          JSON   TTL 300s     single document\ninv:{tenant}                 INCR                bumps {v} above and\n                                                 voids every cached\n                                                 query for that tenant\n\nL1  in-process LRU, 10k entries, 5s TTL   absorbs hot-key bursts\n    single-flight per key so a miss cannot stampede OpenSearch\nEvery key is tenant-prefixed: a cache bug cannot leak across tenants.",
      "lineHeight": 1.25,
      "autoResize": true
    },
