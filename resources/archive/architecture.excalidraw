    {
      "id": "el85",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2055665571,
      "version": 1,
      "versionNonce": 693373551,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 80,
      "y": 1143,
      "width": 496.79999999999995,
      "height": 195.0,
      "text": "R1  GET /search?q=..&tenant=acme      JWT claim must match ?tenant\nR2  Rate limit:  INCR rl:{tenant}:{minute}     over limit -> 429\nR3  L1 in-proc LRU (5s)  ->  L2 Redis  q:{tenant}:{v}:{sha1(...)}\nR4  MISS -> OpenSearch chunks-{group},  routing = tenant_id\n        bool.filter[ term tenant_id ] + multi_match(title^3, text)\n        collapse: { field: doc_id, inner_hits: top 3 passages }\nR5  Best passage per doc  ->  highlight + page no. + char offset\n        UI deep-links straight into the file:  /documents/{id}#page=7\nR6  SETEX 60s, emit span + RED metrics, return 200\n\np95 budget   gateway 5ms | rl 1ms | cache 2ms | ES 60-120ms | ser 5ms\n             collapse costs ~15ms over a flat doc-level query\n             cache HIT returns in ~8ms   (target 60-70% hit rate)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "R1  GET /search?q=..&tenant=acme      JWT claim must match ?tenant\nR2  Rate limit:  INCR rl:{tenant}:{minute}     over limit -> 429\nR3  L1 in-proc LRU (5s)  ->  L2 Redis  q:{tenant}:{v}:{sha1(...)}\nR4  MISS -> OpenSearch chunks-{group},  routing = tenant_id\n        bool.filter[ term tenant_id ] + multi_match(title^3, text)\n        collapse: { field: doc_id, inner_hits: top 3 passages }\nR5  Best passage per doc  ->  highlight + page no. + char offset\n        UI deep-links straight into the file:  /documents/{id}#page=7\nR6  SETEX 60s, emit span + RED metrics, return 200\n\np95 budget   gateway 5ms | rl 1ms | cache 2ms | ES 60-120ms | ser 5ms\n             collapse costs ~15ms over a flat doc-level query\n             cache HIT returns in ~8ms   (target 60-70% hit rate)",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el86",
