      "width": 561.6,
      "height": 422.5,
      "text": "docs-{index_group}     parent metadata,  6 shards x 1, routing=tenant_id\nchunks-{index_group}   passage text,    12 shards x 1, routing=tenant_id\nalias  docs-search / chunks-search  ->  zero-downtime reindex swap\n\nchunks mapping\n{ \"properties\": {\n    \"tenant_id\":  { \"type\": \"keyword\" },\n    \"doc_id\":     { \"type\": \"keyword\" },\n    \"chunk_no\":   { \"type\": \"integer\" },\n    \"page\":       { \"type\": \"integer\" },\n    \"char_start\": { \"type\": \"integer\" },\n    \"text\":       { \"type\": \"text\", \"analyzer\": \"english\" },\n    \"title\":      { \"type\": \"text\", \"analyzer\": \"english\" },\n    \"metadata\":   { \"type\": \"flattened\" },\n    \"version\":    { \"type\": \"long\" } } }\n\n-- one hit per document, best passages attached\n-- the tenant filter is injected by the repo layer; no caller opts out\n{ \"query\": { \"bool\": {\n    \"filter\": [ { \"term\": { \"tenant_id\": \"acme\" } } ],\n    \"must\":   [ { \"multi_match\": { \"query\": \"<q>\", \"fuzziness\": \"AUTO\",\n                    \"fields\": [ \"title^3\", \"text\" ] } } ] } },\n  \"collapse\": { \"field\": \"doc_id\",\n                \"inner_hits\": { \"name\": \"passages\", \"size\": 3,\n                  \"highlight\": { \"fields\": { \"text\": {} } } } },\n  \"aggs\": { \"dept\": { \"terms\": { \"field\": \"metadata.dept\" } } } }",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "docs-{index_group}     parent metadata,  6 shards x 1, routing=tenant_id\nchunks-{index_group}   passage text,    12 shards x 1, routing=tenant_id\nalias  docs-search / chunks-search  ->  zero-downtime reindex swap\n\nchunks mapping\n{ \"properties\": {\n    \"tenant_id\":  { \"type\": \"keyword\" },\n    \"doc_id\":     { \"type\": \"keyword\" },\n    \"chunk_no\":   { \"type\": \"integer\" },\n    \"page\":       { \"type\": \"integer\" },\n    \"char_start\": { \"type\": \"integer\" },\n    \"text\":       { \"type\": \"text\", \"analyzer\": \"english\" },\n    \"title\":      { \"type\": \"text\", \"analyzer\": \"english\" },\n    \"metadata\":   { \"type\": \"flattened\" },\n    \"version\":    { \"type\": \"long\" } } }\n\n-- one hit per document, best passages attached\n-- the tenant filter is injected by the repo layer; no caller opts out\n{ \"query\": { \"bool\": {\n    \"filter\": [ { \"term\": { \"tenant_id\": \"acme\" } } ],\n    \"must\":   [ { \"multi_match\": { \"query\": \"<q>\", \"fuzziness\": \"AUTO\",\n                    \"fields\": [ \"title^3\", \"text\" ] } } ] } },\n  \"collapse\": { \"field\": \"doc_id\",\n                \"inner_hits\": { \"name\": \"passages\", \"size\": 3,\n                  \"highlight\": { \"fields\": { \"text\": {} } } } },\n  \"aggs\": { \"dept\": { \"terms\": { \"field\": \"metadata.dept\" } } } }",
