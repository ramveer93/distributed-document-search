    {
      "id": "el94",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1720926263,
      "version": 1,
      "versionNonce": 973838694,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 80,
      "y": 1699.0,
      "width": 561.6,
      "height": 585.0,
      "text": "POST /documents                                          -> 202\n  Authorization: Bearer <jwt>        X-Tenant-Id: acme\n  Idempotency-Key: 9f1c-4a2b-...\n\n  (a) JSON  -- caller already holds the text\n      { \"title\":\"Q3 Revenue Report\", \"body\":\"<full text>\",\n        \"content_type\":\"text/plain\",\n        \"metadata\":{ \"dept\":\"finance\", \"year\":2025 } }\n  (b) multipart/form-data  -- a real file, we extract it\n      file=@q3-report.pdf   metadata={\"dept\":\"finance\"}\n  (c) > 5 MB  ->  POST /documents:presign, then client PUTs to S3\n\n  202 { \"id\":\"3f9a...\", \"status\":\"PENDING\", \"version\":1 }\n\nGET /search?q=revenue&tenant=acme&page=1&size=20\n           &filter[dept]=finance&highlight=true&fuzzy=auto\n  200 { \"took_ms\":42, \"total\":1384, \"cache\":\"HIT\",\n        \"hits\":[ { \"id\":\"3f9a...\", \"score\":8.21,\n                   \"title\":\"Q3 Revenue Report\",\n                   \"mime_type\":\"application/pdf\", \"page_count\":47,\n                   \"passages\":[ { \"page\":7, \"char_start\":2210,\n                     \"text\":\"..<em>revenue</em> grew 18% YoY..\" } ] } ],\n        \"facets\":{ \"dept\":{ \"finance\":812, \"ops\":301 } } }\n\nGET    /documents/{id}       200 | 404     tenant-scoped, 404 not 403\n       { \"id\":\"...\", \"status\":\"FAILED\",\n         \"failure_reason\":\"encrypted pdf, no password supplied\" }\nGET    /documents/{id}/raw   302 -> presigned S3 URL, 60s TTL\nDELETE /documents/{id}       204           soft delete + tombstone\nGET    /health               200 | 503\n  { \"status\":\"degraded\",\n    \"deps\":{ \"postgres\":\"up\", \"redis\":\"up\", \"opensearch\":\"up\",\n             \"extract_lag\":842, \"index_lag\":12043 } }\n\nErrors  RFC 7807 problem+json, always carries trace_id\n429     X-RateLimit-Limit / -Remaining / -Reset  + Retry-After",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /documents                                          -> 202\n  Authorization: Bearer <jwt>        X-Tenant-Id: acme\n  Idempotency-Key: 9f1c-4a2b-...\n\n  (a) JSON  -- caller already holds the text\n      { \"title\":\"Q3 Revenue Report\", \"body\":\"<full text>\",\n        \"content_type\":\"text/plain\",\n        \"metadata\":{ \"dept\":\"finance\", \"year\":2025 } }\n  (b) multipart/form-data  -- a real file, we extract it\n      file=@q3-report.pdf   metadata={\"dept\":\"finance\"}\n  (c) > 5 MB  ->  POST /documents:presign, then client PUTs to S3\n\n  202 { \"id\":\"3f9a...\", \"status\":\"PENDING\", \"version\":1 }\n\nGET /search?q=revenue&tenant=acme&page=1&size=20\n           &filter[dept]=finance&highlight=true&fuzzy=auto\n  200 { \"took_ms\":42, \"total\":1384, \"cache\":\"HIT\",\n        \"hits\":[ { \"id\":\"3f9a...\", \"score\":8.21,\n                   \"title\":\"Q3 Revenue Report\",\n                   \"mime_type\":\"application/pdf\", \"page_count\":47,\n                   \"passages\":[ { \"page\":7, \"char_start\":2210,\n                     \"text\":\"..<em>revenue</em> grew 18% YoY..\" } ] } ],\n        \"facets\":{ \"dept\":{ \"finance\":812, \"ops\":301 } } }\n\nGET    /documents/{id}       200 | 404     tenant-scoped, 404 not 403\n       { \"id\":\"...\", \"status\":\"FAILED\",\n         \"failure_reason\":\"encrypted pdf, no password supplied\" }\nGET    /documents/{id}/raw   302 -> presigned S3 URL, 60s TTL\nDELETE /documents/{id}       204           soft delete + tombstone\nGET    /health               200 | 503\n  { \"status\":\"degraded\",\n    \"deps\":{ \"postgres\":\"up\", \"redis\":\"up\", \"opensearch\":\"up\",\n             \"extract_lag\":842, \"index_lag\":12043 } }\n\nErrors  RFC 7807 problem+json, always carries trace_id\n429     X-RateLimit-Limit / -Remaining / -Reset  + Retry-After",
      "lineHeight": 1.25,
      "autoResize": true
    },
