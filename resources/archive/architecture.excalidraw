      "type": "text",
      "x": 1780,
      "y": 1664.0,
      "width": 424.32,
      "height": 21.25,
      "text": "EXTRACTION & CHUNKING  \u2014  searching inside files",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EXTRACTION & CHUNKING  \u2014  searching inside files",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el100",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1920828234,
      "version": 1,
      "versionNonce": 1501175504,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1780,
      "y": 1699.0,
      "width": 546.0,
      "height": 438.75,
      "text": "formats    pdf docx pptx xlsx odt rtf html md txt eml csv\n           scanned pdf / png / jpg / tiff  ->  Tesseract OCR\n           OCR gets its own topic + worker pool: 100x slower,\n           and it must never share a queue with plain text\n\nlimits     100 MB / file \u00b7 2000 pages \u00b7 30s CPU budget per doc\n           over budget -> split into page ranges, fan out, rejoin\n           unknown mime -> status=FAILED, not a silent drop\n\nchunking   800 tokens, 100 token overlap, never split mid-sentence\n           each chunk carries page + char_start + char_end\n           doc under 800 tokens = exactly 1 chunk, collapse is free\n\nwhy chunk  BM25 over a whole 300-page PDF ranks the file, not the\n           passage -- a 2-word match scores like a dense section,\n           and there is no snippet worth showing. Passage-level\n           scoring is what makes long-document search usable, and\n           it is what produces the highlight + page deep-link.\n\nsizing     10M docs x avg 12 chunks   =  ~120M chunk docs\n           ~1.5 KB indexed per chunk  =  ~180 GB, x2 replicas = 360 GB\n           6 data nodes, 64 GB heap each, holds this comfortably\n           OCR backlog is the real capacity risk, not query load\n\nlater      the same chunk table is where embeddings go if this ever\n           needs hybrid / semantic search -- dense_vector on chunks,\n           RRF against BM25. Chunking now avoids a reindex then.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "formats    pdf docx pptx xlsx odt rtf html md txt eml csv\n           scanned pdf / png / jpg / tiff  ->  Tesseract OCR\n           OCR gets its own topic + worker pool: 100x slower,\n           and it must never share a queue with plain text\n\nlimits     100 MB / file \u00b7 2000 pages \u00b7 30s CPU budget per doc\n           over budget -> split into page ranges, fan out, rejoin\n           unknown mime -> status=FAILED, not a silent drop\n\nchunking   800 tokens, 100 token overlap, never split mid-sentence\n           each chunk carries page + char_start + char_end\n           doc under 800 tokens = exactly 1 chunk, collapse is free\n\nwhy chunk  BM25 over a whole 300-page PDF ranks the file, not the\n           passage -- a 2-word match scores like a dense section,\n           and there is no snippet worth showing. Passage-level\n           scoring is what makes long-document search usable, and\n           it is what produces the highlight + page deep-link.\n\nsizing     10M docs x avg 12 chunks   =  ~120M chunk docs\n           ~1.5 KB indexed per chunk  =  ~180 GB, x2 replicas = 360 GB\n           6 data nodes, 64 GB heap each, holds this comfortably\n           OCR backlog is the real capacity risk, not query load\n\nlater      the same chunk table is where embeddings go if this ever\n           needs hybrid / semantic search -- dense_vector on chunks,\n           RRF against BM25. Chunking now avoids a reindex then.",
      "lineHeight": 1.25,
      "autoResize": true
    },
