    {
      "id": "el97",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 119988829,
      "version": 1,
      "versionNonce": 1200093500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 940,
      "y": 1699.0,
      "width": 569.4,
      "height": 747.5,
      "text": "tenants\n  tenant_id       TEXT         PRIMARY KEY\n  name            TEXT         NOT NULL\n  plan            TEXT         free | pro | enterprise\n  rate_limit_rps  INT          DEFAULT 100\n  index_group     SMALLINT     -> which OpenSearch index\n  created_at      TIMESTAMPTZ  DEFAULT now()\n\ndocuments                      PARTITION BY HASH (tenant_id)  x 16\n  id              UUID\n  tenant_id       TEXT         NOT NULL REFERENCES tenants\n  title           TEXT         NOT NULL\n  storage_key     TEXT         {tenant}/{doc_id}/raw   (NULL if json)\n  mime_type       TEXT         application/pdf, text/plain, ...\n  byte_size       BIGINT\n  checksum_sha256 TEXT         integrity + dedupe\n  page_count      INT          filled in by extraction\n  lang            TEXT         detected -> picks the ES analyzer\n  chunk_count     INT\n  body            TEXT         extracted text, NULL until W5\n  metadata        JSONB\n  version         BIGINT       NOT NULL DEFAULT 1\n  status          TEXT         PENDING | EXTRACTED | LIVE\n                               | FAILED | DELETED\n  failure_reason  TEXT\n  created_at      TIMESTAMPTZ\n  updated_at      TIMESTAMPTZ\n  PRIMARY KEY (tenant_id, id)\n  INDEX  (tenant_id, updated_at DESC)\n  INDEX  (tenant_id, status) WHERE status <> 'LIVE'   -- ops backlog\n  UNIQUE (tenant_id, checksum_sha256)                 -- re-upload dedupe\n  GIN    (metadata jsonb_path_ops)\n  RLS    USING (tenant_id = current_setting('app.tenant_id'))\n\nindex_outbox                   -- transactional outbox\n  seq             BIGSERIAL    PRIMARY KEY\n  doc_id          UUID\n  tenant_id       TEXT\n  op              TEXT         EXTRACT | UPSERT | DELETE\n  version         BIGINT\n  payload         JSONB\n  published_at    TIMESTAMPTZ  NULL\n  INDEX (seq) WHERE published_at IS NULL     -- relay cursor\n\nChunks live only in OpenSearch. They are 100% derivable from\nS3 raw bytes + this table, so they are never backed up.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "tenants\n  tenant_id       TEXT         PRIMARY KEY\n  name            TEXT         NOT NULL\n  plan            TEXT         free | pro | enterprise\n  rate_limit_rps  INT          DEFAULT 100\n  index_group     SMALLINT     -> which OpenSearch index\n  created_at      TIMESTAMPTZ  DEFAULT now()\n\ndocuments                      PARTITION BY HASH (tenant_id)  x 16\n  id              UUID\n  tenant_id       TEXT         NOT NULL REFERENCES tenants\n  title           TEXT         NOT NULL\n  storage_key     TEXT         {tenant}/{doc_id}/raw   (NULL if json)\n  mime_type       TEXT         application/pdf, text/plain, ...\n  byte_size       BIGINT\n  checksum_sha256 TEXT         integrity + dedupe\n  page_count      INT          filled in by extraction\n  lang            TEXT         detected -> picks the ES analyzer\n  chunk_count     INT\n  body            TEXT         extracted text, NULL until W5\n  metadata        JSONB\n  version         BIGINT       NOT NULL DEFAULT 1\n  status          TEXT         PENDING | EXTRACTED | LIVE\n                               | FAILED | DELETED\n  failure_reason  TEXT\n  created_at      TIMESTAMPTZ\n  updated_at      TIMESTAMPTZ\n  PRIMARY KEY (tenant_id, id)\n  INDEX  (tenant_id, updated_at DESC)\n  INDEX  (tenant_id, status) WHERE status <> 'LIVE'   -- ops backlog\n  UNIQUE (tenant_id, checksum_sha256)                 -- re-upload dedupe\n  GIN    (metadata jsonb_path_ops)\n  RLS    USING (tenant_id = current_setting('app.tenant_id'))\n\nindex_outbox                   -- transactional outbox\n  seq             BIGSERIAL    PRIMARY KEY\n  doc_id          UUID\n  tenant_id       TEXT\n  op              TEXT         EXTRACT | UPSERT | DELETE\n  version         BIGINT\n  payload         JSONB\n  published_at    TIMESTAMPTZ  NULL\n  INDEX (seq) WHERE published_at IS NULL     -- relay cursor\n\nChunks live only in OpenSearch. They are 100% derivable from\nS3 raw bytes + this table, so they are never backed up.",
      "lineHeight": 1.25,
      "autoResize": true
    },
