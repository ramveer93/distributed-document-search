    },
    {
      "id": "el58",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2082899072,
      "version": 1,
      "versionNonce": 783156688,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 120,
      "y": 1003,
      "width": 507.0,
      "height": 276.25,
      "text": "the gateway REWRITES the request before anyone downstream sees it\n\n   verify Authorization: Bearer <jwt>\n   inject   X-Tenant-Id     from the token claim\n            X-User-Id       from the token claim\n            X-Session-Id\n            X-Request-Id    generated here, the trace id\n   STRIP    any inbound X-Tenant-Id the client tried to send\n\nthat last line is the whole security model.  without it,\ncurl -H \"X-Tenant-Id: someone-else\" reads another tenant's\ndocuments.  with it, services never parse a token and the\nheader is authoritative because it was minted, not received.\n\n/health is the only endpoint exempt  \u2014  k8s probes cannot\nsend a JWT.  the detailed dependency version binds to the\ninternal port only.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the gateway REWRITES the request before anyone downstream sees it\n\n   verify Authorization: Bearer <jwt>\n   inject   X-Tenant-Id     from the token claim\n            X-User-Id       from the token claim\n            X-Session-Id\n            X-Request-Id    generated here, the trace id\n   STRIP    any inbound X-Tenant-Id the client tried to send\n\nthat last line is the whole security model.  without it,\ncurl -H \"X-Tenant-Id: someone-else\" reads another tenant's\ndocuments.  with it, services never parse a token and the\nheader is authoritative because it was minted, not received.\n\n/health is the only endpoint exempt  \u2014  k8s probes cannot\nsend a JWT.  the detailed dependency version binds to the\ninternal port only.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el59",
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
