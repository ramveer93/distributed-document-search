      "seed": 439717025,
      "version": 1,
      "versionNonce": 1001929,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1860,
      "y": 1615.5,
      "width": 529.1999999999999,
      "height": 105.0,
      "text": "page <= 500    from / size, as normal\npage >  500    403 + a next_cursor  (search_after underneath)\n\nfrom=10000 makes EVERY shard collect 10,020 hits and throw away\n9,980 of them.  the classic way a search cluster falls over, so\nthe cap is deliberate rather than a limitation.",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "page <= 500    from / size, as normal\npage >  500    403 + a next_cursor  (search_after underneath)\n\nfrom=10000 makes EVERY shard collect 10,020 hits and throw away\n9,980 of them.  the classic way a search cluster falls over, so\nthe cap is deliberate rather than a limitation.",
      "lineHeight": 1.25,
      "autoResize": true
    },
