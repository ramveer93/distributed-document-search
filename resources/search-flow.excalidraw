      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 980,
      "y": 968,
      "width": 229.84,
      "height": 21.25,
      "text": "WHAT GOES TO ELASTICSEARCH",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHAT GOES TO ELASTICSEARCH",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el61",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1799361520,
      "version": 1,
      "versionNonce": 1585932014,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 980,
      "y": 1003,
      "width": 491.4,
      "height": 292.5,
      "text": "POST /docs/_search?routing=acme\n\n{ \"query\": { \"bool\": {\n    \"filter\": [ { \"term\": { \"tenant_id\": \"acme\" } } ],\n    \"must\":   [ { \"multi_match\": {\n        \"query\":  \"refund\",\n        \"fields\": [ \"title^3\", \"text\" ],\n        \"fuzziness\": \"AUTO\" } } ] } },\n  \"highlight\": { \"fields\": { \"text\": {} } },\n  \"from\": 0, \"size\": 20 }\n\nrouting=acme    one shard answers, not all of them.  the single\n                biggest reason the latency budget works.\nfilter not must does not affect the score, and Elasticsearch\n                caches it as a bitset  \u2014  free after the first\n                query.  injected by the repository layer, so no\n                caller can omit it.\ntitle^3         a title match counts three times a body match.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /docs/_search?routing=acme\n\n{ \"query\": { \"bool\": {\n    \"filter\": [ { \"term\": { \"tenant_id\": \"acme\" } } ],\n    \"must\":   [ { \"multi_match\": {\n        \"query\":  \"refund\",\n        \"fields\": [ \"title^3\", \"text\" ],\n        \"fuzziness\": \"AUTO\" } } ] } },\n  \"highlight\": { \"fields\": { \"text\": {} } },\n  \"from\": 0, \"size\": 20 }\n\nrouting=acme    one shard answers, not all of them.  the single\n                biggest reason the latency budget works.\nfilter not must does not affect the score, and Elasticsearch\n                caches it as a bitset  \u2014  free after the first\n                query.  injected by the repository layer, so no\n                caller can omit it.\ntitle^3         a title match counts three times a body match.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el62",
      "angle": 0,
      "strokeColor": "#e03131",
