    {
      "id": "el124",
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 913882254,
      "version": 1,
      "versionNonce": 1258282194,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1770,
      "y": 990,
      "width": 312.0,
      "height": 162.5,
      "text": "32 partitions   \u00b7   key = doc_id\n\nONE topic for every tenant.  tenant is a\nFIELD in the message, never topology.\n\ndeletes ride this same topic  \u2014  a soft\ndelete is an UPDATE, so Debezium emits\nop:u with status=DELETED.  splitting it\nout would lose ordering against the\nUPSERT and resurrect deleted documents.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "32 partitions   \u00b7   key = doc_id\n\nONE topic for every tenant.  tenant is a\nFIELD in the message, never topology.\n\ndeletes ride this same topic  \u2014  a soft\ndelete is an UPDATE, so Debezium emits\nop:u with status=DELETED.  splitting it\nout would lose ordering against the\nUPSERT and resurrect deleted documents.",
      "lineHeight": 1.25,
      "autoResize": true
    },
