      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 880,
      "y": 2242,
      "width": 487.2,
      "height": 175.0,
      "text": "1   S3 always lands before the row.\n    a row can never point at bytes that are not there yet.\n    the reverse leaves an orphan blob, which is harmless.\n\n2   the Indexer only ever touches PENDING.\n    safe to write the row early, and the LIVE write-back\n    cannot loop back around through Debezium.\n\n3   /raw is immutable, /text is derived.\n    a reindex reads /text and never re-parses 10 M PDFs.",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1   S3 always lands before the row.\n    a row can never point at bytes that are not there yet.\n    the reverse leaves an orphan blob, which is harmless.\n\n2   the Indexer only ever touches PENDING.\n    safe to write the row early, and the LIVE write-back\n    cannot loop back around through Debezium.\n\n3   /raw is immutable, /text is derived.\n    a reindex reads /text and never re-parses 10 M PDFs.",
      "lineHeight": 1.25,
      "autoResize": true
    },
