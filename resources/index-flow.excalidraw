      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el108",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 514982154,
      "version": 1,
      "versionNonce": 1668748296,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 1480,
      "y": 193,
      "width": 475.79999999999995,
      "height": 260.0,
      "text": "<= 256 KB        body lives in the Postgres row       1 call\n                 no S3 at all, one atomic INSERT\n\n256 KB - 5 MB    Ingest streams it to S3 itself       1 call\n                 row keeps the s3_key\n\n5 MB - 100 MB    single presigned PUT                 3 calls\n                 negotiate / upload / commit\n\n> 100 MB         S3 multipart, parts in parallel      3 calls\n                 a failure at 95% costs one part,\n                 not the whole file\n\nIngest picks the tier and TELLS the client.  the client never\nchooses.  both thresholds are implementation details you can\nretune on a Tuesday without touching a single client.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<= 256 KB        body lives in the Postgres row       1 call\n                 no S3 at all, one atomic INSERT\n\n256 KB - 5 MB    Ingest streams it to S3 itself       1 call\n                 row keeps the s3_key\n\n5 MB - 100 MB    single presigned PUT                 3 calls\n                 negotiate / upload / commit\n\n> 100 MB         S3 multipart, parts in parallel      3 calls\n                 a failure at 95% costs one part,\n                 not the whole file\n\nIngest picks the tier and TELLS the client.  the client never\nchooses.  both thresholds are implementation details you can\nretune on a Tuesday without touching a single client.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el109",
