      "locked": false,
      "type": "text",
      "x": 250,
      "y": 1440,
      "width": 413.4,
      "height": 113.75,
      "text": "INSIDE THE INDEXER\n  /text already in S3?  ->  use it, skip extraction\n  else stream /raw to a temp file on local disk\n  sniff magic bytes  %PDF / PK  \u2014  never Content-Type\n  extract page by page:  pypdf \u00b7 python-docx \u00b7 decode\n  PDF with pages but no text  ->  FAILED 'needs OCR'\n  temp file deleted on the way out, exception or not",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "INSIDE THE INDEXER\n  /text already in S3?  ->  use it, skip extraction\n  else stream /raw to a temp file on local disk\n  sniff magic bytes  %PDF / PK  \u2014  never Content-Type\n  extract page by page:  pypdf \u00b7 python-docx \u00b7 decode\n  PDF with pages but no text  ->  FAILED 'needs OCR'\n  temp file deleted on the way out, exception or not",
      "lineHeight": 1.25,
      "autoResize": true
    },
