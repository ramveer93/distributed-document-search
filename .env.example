# ---------------------------------------------------------------- postgres
PG_HOST=postgres
PG_PORT=5432
PG_DB=deeprunner
PG_USER=deeprunner
PG_PASSWORD=change-me

# ----------------------------------------------------------- elasticsearch
ES_URL=http://elasticsearch:9200
ES_INDEX=documents
ES_SHARDS=2
ES_REPLICAS=0

# ------------------------------------------------------------------- redis
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------- kafka
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=doc.index.v1
KAFKA_DLQ_TOPIC=doc.index.dlq
KAFKA_PARTITIONS=12
KAFKA_GROUP=indexer

# ---------------------------------------------------------- s3 (via minio)
S3_ENDPOINT=http://minio:9000
# what the BROWSER uses — SigV4 signs the Host, so presigned URLs
# must be signed against the address the client will actually call
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_PRESIGN_TTL=60

# -------------------------------------------------------------------- auth
JWT_ISSUER=deeprunner
JWT_AUDIENCE=deeprunner-api
JWT_TTL_SECONDS=900
# RS256 keypair is generated by the gateway at startup and published on
# /.well-known/jwks.json — no private key is ever stored on disk.

# --------------------------------------------------------- service routing
GATEWAY_PORT=8080
GATEWAY_INTERNAL_URL=http://gateway:8080
API_PORT=8081
# all three blueprints live in one API deployable
API_URL=http://api:8081

# ---------------------------------------------------------------- tunables
INLINE_BODY_MAX_BYTES=262144
QUERY_CACHE_TTL=60
DOC_CACHE_TTL=300
L1_CACHE_TTL=5
MAX_PAGE=500
MAX_ATTEMPTS=3
LOG_LEVEL=INFO
