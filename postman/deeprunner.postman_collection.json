{
  "info": {
    "name": "Deeprunner",
    "description": "Multi-tenant document search.\n\nRun **Auth -> Log in (acme)** first: it stores the JWT in a collection variable that every other request uses.\n\nThe whole collection is runnable. Postman's Collection Runner executes the assertions in each request, so it doubles as an end-to-end test.\n\n`baseUrl` defaults to the frontend origin, which proxies to the gateway. Point it at http://localhost:8080 to hit the gateway directly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "globexToken",
      "value": ""
    },
    {
      "key": "docId",
      "value": ""
    },
    {
      "key": "s3DocId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in (acme)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@acme.com\",\n  \"password\": \"demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Stores the token for every other request. Run this first.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", b.access_token);",
                  "pm.test(\"tenant comes from the token, not the client\",",
                  "  () => pm.expect(b.tenant).to.eql(\"acme\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in (globex) - second tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@globex.com\",\n  \"password\": \"demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A different tenant, used by the isolation folder.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"globexToken\", pm.response.json().access_token);",
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in (suspended tenant) -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carol@initech.com\",\n  \"password\": \"demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Valid credentials, but the tenant is SUSPENDED. Identity comes from the token; authorisation state comes from the database.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in (wrong password) -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@acme.com\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "JWKS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/jwks.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            },
            "description": "Public half of the RS256 signing key; services fetch it to verify tokens.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Index text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Refund policy\",\n  \"body\": \"Customers may request a refund within 30 days of purchase.\",\n  \"metadata\": {\n    \"dept\": \"finance\",\n    \"year\": 2025\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "202, not 201: durably stored but not yet searchable. Poll 'Get by id' until status is LIVE."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"docId\", b.id);",
                  "pm.test(\"starts PENDING\", () => pm.expect(b.status).to.eql(\"PENDING\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Index a large document (> 256 KB -> S3)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ~340 KB, comfortably over the 256 KB threshold",
                  "pm.variables.set(\"bigBody\", \"quarterly compliance review \".repeat(12000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202\", () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set(\"s3DocId\", pm.response.json().id);",
                  "// the body was too large for the Postgres row, so it went to S3 and",
                  "// this is the document the download requests can actually fetch"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Large compliance report\",\n  \"body\": \"{{bigBody}}\",\n  \"metadata\": { \"dept\": \"legal\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "description": "Bodies at or under 256 KB live in the Postgres row; larger ones go to S3 and the row keeps only the key. A backend detail \u2014 no client sees it, and the request looks identical. This one crosses the line, which is why the download requests below have something to fetch."
          },
          "response": []
        },
        {
          "name": "Upload a file (pick one in Body first)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "pick a PDF, DOCX or HTML file"
                },
                {
                  "key": "metadata",
                  "value": "{\"dept\":\"legal\"}",
                  "type": "text"
                }
              ]
            },
            "description": "Text is extracted by the indexer, never by the API. Select a file in the Body tab before sending."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) {",
                  "  pm.collectionVariables.set(\"docId\", pm.response.json().id);",
                  "  pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
                  "} else {",
                  "  // no file selected \u2014 skipped rather than failed, so the runner",
                  "  // can execute the collection unattended",
                  "  pm.test.skip(\"needs a file selected in the Body tab\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{docId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{docId}}"
              ]
            },
            "description": "Reads Postgres, so it answers during PENDING when Elasticsearch has nothing yet. 'progress' shows the three indexing stages."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"has progress stages\", () => pm.expect(b.progress).to.have.lengthOf(3));",
                  "console.log(\"status:\", b.status);"
                ]
              }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents?page=1&size=25&status=LIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "25"
                },
                {
                  "key": "status",
                  "value": "LIVE"
                }
              ]
            },
            "description": "Tenant-scoped. status is optional: LIVE, PENDING or FAILED."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"paginated\", () => pm.expect(pm.response.json()).to.have.property(\"total\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download original -> 302",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{s3DocId}}/raw",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{s3DocId}}",
                "raw"
              ]
            },
            "description": "302 to a presigned S3 URL valid for 60s \u2014 the bytes never pass through the API.\n\nRedirect following is turned OFF for this request on purpose. Follow it with the Authorization header still attached and S3 returns 400: a presigned URL is its own credential and must not also carry a bearer token.\n\nUses the large document, since a small one keeps its body in the Postgres row and has no S3 object to redirect to."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"302 to a presigned URL\", () => pm.response.to.have.status(302));",
                  "const loc = pm.response.headers.get(\"Location\");",
                  "pm.test(\"presigned, and short lived\", () => {",
                  "  pm.expect(loc).to.include(\"X-Amz-Signature\");",
                  "  pm.expect(loc).to.include(\"X-Amz-Expires=60\");",
                  "});",
                  "console.log(\"bytes come from:\", loc.split(\"?\")[0]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Download original -> JSON url",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents/{{s3DocId}}/raw",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{s3DocId}}",
                "raw"
              ]
            },
            "description": "Same endpoint, content-negotiated. A browser cannot put a bearer token on an <a href>, so the page fetches the URL with auth then navigates.\n\nUses the large document, since a small one has its body in the Postgres row and no S3 object to redirect to (a correct 404)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns a presigned url\",",
                  "  () => pm.expect(pm.response.json().url).to.include(\"X-Amz-Signature\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{docId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{docId}}"
              ]
            },
            "description": "Soft delete. Gone from search within ~2s and GET returns 404, but the row survives - it is what tells the async cleanup what to clean."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=refund&page=1&size=20&facets=dept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "refund"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "facets",
                  "value": "dept"
                }
              ]
            },
            "description": "cache is MISS the first time and HIT for 60s after. total.relation is 'gte' past 10,000 - a lower bound, not an exact count."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"total is an object, never a bare int\",",
                  "  () => pm.expect(b.total).to.have.property(\"relation\"));",
                  "console.log(`${b.total.value} hits, ${b.took_ms}ms, cache=${b.cache}`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search - fuzzy off, no highlight",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=refund&fuzzy=false&highlight=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "refund"
                },
                {
                  "key": "fuzzy",
                  "value": "false"
                },
                {
                  "key": "highlight",
                  "value": "false"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search - deep page rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=refund&page=99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "refund"
                },
                {
                  "key": "page",
                  "value": "99999"
                }
              ]
            },
            "description": "from=10000 would make every shard collect 10,020 hits and discard 9,980. The cap is deliberate."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tenant isolation",
      "item": [
        {
          "name": "globex reads an acme document -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{globexToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents/{{docId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{docId}}"
              ]
            },
            "description": "404, not 403. A 403 would confirm the document exists, turning id enumeration into an information leak.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404, not 403\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "globex cannot see acme's document",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{globexToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search?q=refund",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "refund"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "globex legitimately has its OWN documents matching 'refund', so asserting zero hits would be wrong. The isolation claim is narrower and sharper: acme's document must never appear in globex's results."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().hits.map(h => h.id);",
                  "pm.test(\"acme's document is absent from globex results\", () =>",
                  "  pm.expect(ids).to.not.include(pm.collectionVariables.get(\"docId\")));",
                  "console.log(`globex sees ${ids.length} of its own documents`);"
                ]
              }
            }
          ]
        },
        {
          "name": "No token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=refund",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "refund"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Public - k8s probes cannot present a token.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dependencies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/detail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "detail"
              ]
            },
            "description": "Per-dependency status. Reveals the stack, so in production this binds to the internal network only.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 or 503\", () => pm.expect([200,503]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}